<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RAVNIX AI</title>
    <link rel="manifest" href="manifest.json">
    <meta name="theme-color" content="#0f172a">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, -apple-system, sans-serif; }
        body { background-color: #0f172a; color: #f8fafc; height: 100vh; display: flex; flex-direction: column; }
        header { background: #1e293b; padding: 1rem; text-align: center; font-weight: bold; font-size: 1.2rem; border-bottom: 1px solid #334155; }
        .chat-container { flex: 1; overflow-y: auto; padding: 1rem; display: flex; flex-direction: column; gap: 1rem; }
        .message { max-width: 80%; padding: 0.8rem 1rem; border-radius: 1rem; line-height: 1.4; }
        .user { background: #3b82f6; color: white; align-self: flex-end; border-bottom-right-radius: 0.2rem; }
        .ai { background: #1e293b; color: #f8fafc; align-self: flex-start; border-bottom-left-radius: 0.2rem; border: 1px solid #334155; }
        .input-area { padding: 1rem; background: #1e293b; display: flex; gap: 0.5rem; border-top: 1px solid #334155; }
        input { flex: 1; background: #0f172a; border: 1px solid #475569; padding: 0.8rem; border-radius: 0.5rem; color: white; font-size: 1rem; outline: none; }
        input:focus { border-color: #3b82f6; }
        button { background: #3b82f6; color: white; border: none; padding: 0 1.2rem; border-radius: 0.5rem; font-weight: bold; cursor: pointer; }
        button:active { background: #2563eb; }
    </style>
</head>
<body>

    <header>RAVNIX AI</header>

    <div class="chat-container" id="chatContainer">
        <div class="message ai">Hola. Soy RAVNIX AI, tu mentor sin filtros. ¿De qué vamos a hablar hoy?</div>
    </div>

    <div class="input-area">
        <input type="text" id="userInput" placeholder="Escribe tu mensaje..." autocomplete="off">
        <button onclick="sendMessage()">Enviar</button>
    </div>

    <script>
        const chatContainer = document.getElementById('chatContainer');
        const userInput = document.getElementById('userInput');

        userInput.addEventListener('keypress', function (e) {
            if (e.key === 'Enter') {
                sendMessage();
            }
        });

        function sendMessage() {
            const text = userInput.value.trim();
            if (!text) return;

            // Mensaje del usuario
            appendMessage(text, 'user');
            userInput.value = '';

            // Respuesta simulada del mentor sin filtros
            setTimeout(() => {
                const reply = getRavnixResponse(text);
                appendMessage(reply, 'ai');
            }, 600);
        }

        function appendMessage(text, sender) {
            const messageDiv = document.createElement('div');
            messageDiv.classList.add('message', sender);
            messageDiv.textContent = text;
            chatContainer.appendChild(messageDiv);
            chatContainer.scrollTop = chatContainer.scrollHeight;
        }

        function getRavnixResponse(input) {
            const lower = input.toLowerCase();
            if (lower.includes('hola') || lower.includes('saludos')) {
                return "Directo al grano. ¿Qué objetivo tienes en mente y qué te está frenando?";
            } else if (lower.includes('consejo') || lower.includes('ayuda')) {
                return "La única regla aquí es dejar las excusas de lado. ¿Cuál es el problema real?";
            } else {
                return "Entendido. Analiza bien tus opciones, toma una decisión y hazlo sin mirar atrás.";
            }
        }
    </script>
</body>
</html>
